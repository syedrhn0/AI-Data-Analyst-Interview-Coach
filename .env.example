# Required: Groq API key for the AI interviewer and Orpheus text-to-speech.
GROQ_API_KEY=your_groq_api_key_here

# Groq chat model used to generate interview questions and feedback.
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Text-to-speech model and default voice.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
# Available Orpheus voices: autumn, diana, hannah, austin, daniel, troy
